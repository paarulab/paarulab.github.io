---
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '/index.html';
const currentPath = pathname.replace(/\/$/, '');
const isAbout = currentPath === '/about';
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="paaru ホーム"><img src="/mysite_icon.jpg" alt="" width="36" height="36" /><span>paaru</span></a>
    <nav aria-label="メインナビゲーション">
      <a href="/" aria-current={isHome ? 'page' : undefined}>Top</a>
      <a href="/works" aria-current={['/works', '/projects'].includes(currentPath) ? 'page' : undefined}>Works</a>
      <a href="/articles" aria-current={currentPath === '/articles' ? 'page' : undefined}>Articles</a>
      <a href="/links" aria-current={currentPath === '/links' ? 'page' : undefined}>Links</a>
      <a href="/about" aria-current={isAbout ? 'page' : undefined}>About</a>
    </nav>
  </div>
</header>
