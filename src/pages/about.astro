---
import Layout from '../layouts/Layout.astro';
---
<Layout title="paaru - About">
  <div class="page-shell about-page">
    <div class="page-title"><h1 class="english-heading">ABOUT</h1></div>
    <section class="profile-panel">
      <div class="profile-picture"><img src="/mysite_icon.jpg" alt="ぱーるのアイコン" width="240" height="240" /><span class="small-label">Try it, no regrets.</span></div>
      <div class="profile-copy"><h2>paaru <span>（ぱーる）</span></h2><p class="school">電気通信大学 情報理工学域I類 2年生</p><p>多趣味人間です。電通大で情報系の勉強を楽しんでいます。<br />サイトのデザインはドラパルトのゴーストタイプっぽさと月夜をイメージしてみました。<br />自分の制作物や記録を載せていけたらいいなと思っています。気楽に見てもらえたら嬉しいです。</p></div>
    </section>
    <div class="about-columns">
      <section class="content-section">
        <div class="section-heading"><div><h2>INTERESTS</h2></div></div>
        <div class="interest-details">
          <div class="interest-item">
            <h3>プログラミング</h3>
            <dl>
              <div><dt>経験</dt><dd>Python、C言語、JavaScript、Small Basic</dd></div>
              <div><dt>勉強中</dt><dd>C++</dd></div>
            </dl>
          </div>
          <div class="interest-item">
            <h3>ポケモン</h3>
            <dl>
              <div><dt>推しポケ</dt><dd>ドラパルト、チルタリス、バタフリー</dd></div>
              <div><dt>ゲーム</dt><dd>ダイパ世代以降ほぼすべて、Pokémon Champions、Pokémon UNITEなど</dd></div>
            </dl>
          </div>
          <div class="interest-item">
            <h3>Mrs. GREEN APPLE</h3>
            <p class="favorite-songs-label">推し曲5選（きまぐれ更新）</p>
            <p class="favorite-songs">CHEERS、アポロドロス、月とアネモネ、CONFLICT、The White Lounge</p>
          </div>
        </div>
      </section>
      <section class="content-section"><div class="section-heading"><div><h2>TIMELINE</h2></div></div><ol class="timeline"><li><time datetime="2026-09">2026.09</time><h3>自サイト公開</h3></li><li><time datetime="2026-06">2026.06</time><h3>初note執筆</h3></li><li><time datetime="2025-04">2025.04</time><h3>電気通信大学 入学</h3></li></ol></section>
    </div>
  </div>
</Layout>
