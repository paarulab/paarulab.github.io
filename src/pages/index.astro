---
import Layout from '../layouts/Layout.astro';
import ArticleList from '../components/ArticleList.astro';
import projects from '../data/projects.json';
---
<Layout title="paaru - Top" description="paaruのホームページ">
  <div class="page-shell home-page">
    <section class="home-hero">
      <div class="hero-copy">
        <h1>paaru</h1>
        <p class="intro">#UEC25 #I類 #情報系<br />とりあえず自分のサイト作ってみました<br>相互リンク募集中です！</p>
        <div class="recently-status" aria-label="Recently: 2Dゲーム開発中 with Godot Engine">
          <span class="recently-moon" aria-hidden="true"></span>
          <span class="recently-label">RECENTLY</span>
          <span class="recently-text">2Dゲーム開発中 with Godot Engine</span>
        </div>
        <a class="pill-link hero-about-link" href="/about">ABOUT <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-art">
        <div class="portrait"><img src="/mysite_icon.jpg" alt="ぱーるのアイコン" width="320" height="320" /></div>
      </div>
    </section>
    <section id="works" class="content-section">
      <div class="section-heading"><div><h2 class="english-heading">WORKS</h2></div></div>
      {projects.map(project => (
        <a class="featured-work" href={project.link} target="_blank" rel="noopener noreferrer">
          <div class="work-image"><img src="/rugby-club.jpg" alt="電早ラグビー部の活動風景" loading="lazy" /></div>
          <div class="work-copy"><p class="eyebrow">WEB DESIGN / DEVELOPMENT</p><h3>{project.title}</h3><p>{project.description}</p><span class="work-action">サイトを見る <span aria-hidden="true">↗</span></span></div>
        </a>
      ))}
    </section>
    <div class="home-bottom">
      <section id="articles" class="content-section"><div class="section-heading"><div><h2 class="english-heading">ARTICLES</h2></div></div><ArticleList /></section>
    </div>
    <div class="site-note page-age">
      <p class="page-age-text">このページができてから<span class="counting-dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span><strong class="page-age-count" id="page-age-count">0日</strong></p>
      <p class="page-age-since">Since Sep, 2026</p>
    </div>
  </div>
</Layout>

<script>
  const dayInMs = 86_400_000;
  const japanOffset = 9 * 60 * 60 * 1000;
  const startDay = Date.UTC(2026, 8, 16);
  const count = document.getElementById('page-age-count');
  let midnightTimer: ReturnType<typeof setTimeout>;

  function updatePageAge() {
    clearTimeout(midnightTimer);
    const japanNow = Date.now() + japanOffset;
    const days = Math.max(0, Math.floor((japanNow - startDay) / dayInMs));
    if (count) count.textContent = `${days}日`;
    midnightTimer = setTimeout(updatePageAge, dayInMs - (japanNow % dayInMs) + 100);
  }

  updatePageAge();
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) updatePageAge();
  });
</script>
