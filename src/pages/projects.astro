---
import Layout from '../layouts/Layout.astro';
import projects from '../data/projects.json';
---

<Layout title="Works | paaharu">
  <div class="max-w-5xl mx-auto px-6 py-16 grid gap-12">

    <h1 class="english-heading">WORKS</h1>

    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((project) => (
        <a href={project.link} target="_blank" rel="noopener noreferrer"
           class="group bg-surface border border-border rounded-xl p-6 hover:border-purple-300 hover:shadow-md transition-all grid gap-4">
          <div class="grid gap-2">
            <h2 class="font-semibold text-text">{project.title}</h2>
            <p class="text-sm text-muted leading-relaxed">{project.description}</p>
          </div>
          <div class="flex flex-wrap gap-2">
            {project.tech.map((t) => (
              <span class="text-xs bg-purple-100 text-muted px-2 py-1 rounded-md">{t}</span>
            ))}
          </div>
          <span class="text-sm text-muted group-hover:text-purple-700 transition-colors justify-self-end">
            詳細を見る →
          </span>
        </a>
      ))}
    </div>

  </div>
</Layout>
